# À copier dans /etc/default/grafana-server (droits 0640, propriétaire root:grafana). JAMAIS dans Git.
# Mots de passe : sans apostrophe ni antislash.
# grafana_ro est un rôle de CLUSTER : un seul mot de passe pour les bases « meteo » et « monitoring »
# si elles sont sur la même instance PostgreSQL (les deux variables ci-dessous reçoivent alors la même valeur).
METEO_GRAFANA_PWD=
ASEMON_GRAFANA_RO_PWD=
ASEMON_GRAFANA_THRESHOLDS_PWD=

# Page d'accueil de Grafana = synthèse Météo multi-instance (c'est la page de connexion « métier »).
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/var/lib/grafana/dashboards/meteo/synthese.json
# Icônes soleil / nuage / orage / lune servies par Grafana sous /public/img/meteo/
# Plugins autorisés (non signés) : aucun, les deux plugins sont signés.
